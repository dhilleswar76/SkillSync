# Root-level environment variables reference
# This file shows all environment variables needed for the project
# Configure these in backend/.env and frontend/.env

# ========================================
# BACKEND (.env in backend/)
# ========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Base URL (for CORS and OAuth redirects)
# Development: http://localhost:5173
# Production: https://skill-sync-learning-portal.vercel.app
FRONTEND_URL=http://localhost:5173

# MongoDB Configuration
# Local: mongodb://localhost:27017/student-portal
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/student_portal
MONGO_URI=mongodb://localhost:27017/student-portal

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# ----------------------------------------
# Google OAuth 2.0 Configuration
# ----------------------------------------
# 1. Go to Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized JavaScript origins:
#    - http://localhost:5173
#    - https://<your-frontend-domain>.vercel.app
# 4. Add Authorized redirect URIs:
#    - http://localhost:5000/api/auth/google/callback
#    - https://<your-backend-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ----------------------------------------
# GitHub OAuth App Configuration
# ----------------------------------------
# 1. Go to GitHub -> Settings -> Developer Settings -> OAuth Apps (https://github.com/settings/developers)
# 2. Click "New OAuth App"
# 3. Homepage URL: http://localhost:5173 (or your production frontend URL)
# 4. Authorization callback URL:
#    - http://localhost:5000/api/auth/github/callback
#    - https://<your-backend-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# SMTP / Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=SkillSync <no-reply@skillsync.com>

# Cloudinary (Optional - for file uploads)
CLOUD_NAME=your_cloud_name
CLOUD_KEY=your_cloud_key
CLOUD_SECRET=your_cloud_secret

# ========================================
# FRONTEND (.env in frontend/)
# ========================================

# Backend API Endpoint
# Development: http://localhost:5000/api
# Production: https://<your-backend-domain>/api
VITE_API_URL=http://localhost:5000/api
