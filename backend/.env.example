# Backend example environment variables for local development
# Copy this file to .nenv or .env and fill values before running the server

# Server
PORT=5000
NODE_ENV=development

# Database
# Use a local MongoDB URI or a MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/student-portal

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRE=30d

# Frontend URL (used for CORS and redirecting after OAuth)
FRONTEND_URL=http://localhost:3000

# Optional public backend URL (used to build callback URLs if needed)
# Example: BACKEND_PUBLIC_URL=https://your-app.example.com
BACKEND_PUBLIC_URL=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
# Create credentials in Google Cloud Console and set these values
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# GitHub OAuth
# Create an OAuth App in GitHub and set these values
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Example redirect URI: http://localhost:5000/api/auth/github/callback
GITHUB_REDIRECT_URI=
# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/student-portal

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# Cloudinary Configuration (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Optional: public backend URL used to auto-build OAuth callbacks when redirect URI is omitted
BACKEND_PUBLIC_URL=http://localhost:5000

# SMTP Email Delivery (for real Email OTP sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SkillSync <your_email@gmail.com>"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# Firebase Admin (for verifying Firebase Phone OTP)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
